# =============================================================================
# Mnemos v6.1 环境变量示例
# -----------------------------------------------------------------------------
# 复制为 .env 后按需修改；.env 不要提交（已在 .gitignore）。
#
# 注意：服务端只读取**进程环境变量**，不会自动加载 .env 文件。
#   - 直接启动：  node --env-file=.env server/src/main.ts
#   - pnpm dev：  pnpm dev 不会自动加载 .env，可在 shell 里 export 或改用上面命令
#   - Docker：    用 docker compose 的 env_file / environment 传入
# 所有变量都有默认值；不配置时使用代码内默认值（生产请按需显式设置）。
# =============================================================================

# --- 服务 ---------------------------------------------------------------
# 监听端口（也兼容 PORT；MNEMOS_PORT 优先）。默认 4380。
MNEMOS_PORT=4380
# 监听地址。生产建议只监听回环，由反向代理终止 TLS。
MNEMOS_HOST=127.0.0.1

# 数据目录。v6 默认 <项目根>/data-v6（与 v5 的 data/ 分离，v5 数据不迁移）。
MNEMOS_DATA_DIR=./data-v6
# SQLite 路径；默认 $MNEMOS_DATA_DIR/mnemos.db。
# MNEMOS_DB_PATH=./data-v6/mnemos.db
# 备份目录；默认 $MNEMOS_DATA_DIR/backups。
# MNEMOS_BACKUP_DIR=./data-v6/backups
# 控制台构建产物目录；默认 <项目根>/web/dist（pnpm build 生成）。
# MNEMOS_WEB_DIST=./web/dist

# 演示模式：1/未设置 = 空库时自动写入演示数据（2 个分区 + 8 个人 + 26 条记忆）；
# 生产必须设 0，避免空库被写入演示账号与密钥。
MNEMOS_DEMO=0
# 登录页「企业微信 Mock 登录」：默认跟随 MNEMOS_DEMO；生产必须为 0。
# 开发/测试想显式开启时设为 1（0/1）。
# MNEMOS_WECOM_MOCK=0
# 仅限本机调试（跳过控制台鉴权，直接以第一个 owner 身份操作）；生产禁止。
MNEMOS_AUTH_DISABLED=0

# --- 会话与登录安全 -----------------------------------------------------
MNEMOS_SESSION_TTL_HOURS=72
# 连续失败多少次锁定账号
MNEMOS_LOGIN_MAX_ATTEMPTS=5
# 锁定时长（分钟）
MNEMOS_LOGIN_LOCK_MINUTES=15

# --- 日志与指标 ---------------------------------------------------------
# debug | info | warn | error
MNEMOS_LOG_LEVEL=info
# json（生产）| pretty（本地）
MNEMOS_LOG_FORMAT=json
# 0 关闭 /metrics（返回 404）
MNEMOS_METRICS_ENABLED=1

# --- 运行参数 -----------------------------------------------------------
# 反向代理后设为 1，用于从 X-Forwarded-For 取真实客户端 IP
MNEMOS_TRUST_PROXY=0
# 由反代终止 TLS 后设为 1，返回 HSTS
MNEMOS_HSTS=0
# 分区月配额强制（settings.monthlyQuota > 0 时生效；超限 429 QUOTA_EXCEEDED）
MNEMOS_QUOTA_ENFORCE=1
MNEMOS_REQUEST_TIMEOUT_MS=30000
MNEMOS_SHUTDOWN_TIMEOUT_MS=10000
# 维护任务间隔（分钟）：过期/保留期归档、软删除清理、WAL checkpoint
MNEMOS_MAINTENANCE_INTERVAL_MIN=360
# 请求体上限（字节，默认 1MB）
MNEMOS_BODY_LIMIT_BYTES=1048576

# --- 可选：OpenAI 兼容模型 ---------------------------------------------
# 不配置（BASE_URL 与 API_KEY 必须同时给）时完全离线可用：简报走
# mnemos-condense 确定性压缩，做梦走确定性归并。
# 配置后：做梦会用模型归纳洞见（失败静默回退确定性实现）。
# v1/控制台读取简报的 HTTP 入口固定使用确定性压缩，不额外调用模型。
# MNEMOS_LLM_BASE_URL=https://api.openai.com/v1
# MNEMOS_LLM_API_KEY=sk-...
# MNEMOS_LLM_MODEL=gpt-4o-mini
# 可选：外部 embedding 模型名（v6.1 默认使用本地 mnemos-hash-384，不依赖网络；
# 分区 settings.embeddingModel 可覆盖；外部失败会回退本地）
# MNEMOS_EMBEDDING_MODEL=text-embedding-3-small

# --- 记忆做梦调度 -------------------------------------------------------
# 默认开启（每次轮询检查到期分区）；设为 0 / false / 空串关闭，
# 关闭后仍可在控制台或 API 手动触发（POST .../dream/run）。
MNEMOS_DREAM_SCHEDULER=1
# 调度器轮询间隔（毫秒），默认 60000，最小 5000。
MNEMOS_DREAM_TICK_MS=60000

# --- v6.1 P2：可选字段级加密 -------------------------------------------
# 配置后 memory_attachments.url 落库前 AES-256-GCM 加密（v1:iv:tag:cipher），读取时解密。
# 不加密 memories.content（避免破坏 FTS / embedding / 去重哈希）；历史明文仍可读。
# 密钥丢失/更换会导致旧附件 URL 无法解密——请与备份一起妥善保管。
# MNEMOS_ENCRYPTION_KEY=change-me-long-random-string

# --- 生产首次启动（MNEMOS_DEMO=0 且库中无用户时必填）------------------
# 缺少这些变量且无用户时进程会拒绝启动。
# MNEMOS_BOOTSTRAP_EMAIL=admin@example.com
# MNEMOS_BOOTSTRAP_PASSWORD=ChangeMe-12345
# MNEMOS_BOOTSTRAP_NAME=平台管理员
# MNEMOS_BOOTSTRAP_ORG_NAME=我的组织
# MNEMOS_BOOTSTRAP_ORG_SLUG=my-org

# --- OpenTelemetry 链路追踪 -------------------------------------------
# 默认关闭；关闭时不加载 OTel SDK、不发起任何网络连接。
MNEMOS_OTEL_ENABLED=0
# OTLP/HTTP trace 端点（注意包含 /v1/traces）。
MNEMOS_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# 采样率 0..1；生产建议 0.05–0.1，排障时可临时设为 1。
MNEMOS_OTEL_SAMPLE_RATE=0.1
MNEMOS_OTEL_SERVICE_NAME=mnemos

# --- 存储驱动 -----------------------------------------------------------
# 当前仅 sqlite（node:sqlite 内置，无需额外安装）；postgres 未实现，启动会拒绝。
MNEMOS_STORAGE=sqlite
