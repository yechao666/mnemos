{
  "name": "mnemos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mnemos — 企业级多项目 AI 记忆基础设施",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch server/src/main.ts",
    "dev:web": "pnpm --filter @mnemos/web run dev",
    "build": "pnpm --filter @mnemos/web run build",
    "start": "node server/src/main.ts",
    "seed": "node server/src/seed/run-seed.ts --force",
    "test": "node --test 'server/src/**/*.test.ts'",
    "eval": "node scripts/eval-memory.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "seed:scale": "node scripts/seed-scale.ts",
    "backfill:embeddings": "node scripts/backfill-embeddings.ts",
    "perf:persons": "node scripts/perf-persons.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
