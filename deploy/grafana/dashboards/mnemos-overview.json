      ]
    },
    {
      "type": "table",
      "id": 11,
      "title": "构建信息 / 运行时长",
      "description": "实例、版本与进程运行时长。uptime 由 /metrics 每次抓取时刷新。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "版本"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "实例"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "运行时长",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mnemos_uptime_seconds{instance=~\"$instance\"} * on(instance) group_left(version) mnemos_build_info{instance=~\"$instance\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "instance": "实例",
              "version": "版本",
              "Value": "运行时长"
            }
          }
        }
      ]
    }
