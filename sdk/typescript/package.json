{
  "name": "@mnemos/sdk",
  "version": "6.1.0",
  "description": "Mnemos v6.1 官方 TypeScript SDK：分区 / 人 / 记忆的混合检索、历史反馈、画像生命周期、图谱与游标分页。零运行时依赖，Node ≥18 与浏览器通用。",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "example": "node examples/basic.ts"
  },
  "keywords": [
    "mnemos",
    "memory",
    "partition",
    "person",
    "agent",
    "cursor",
    "sdk"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
