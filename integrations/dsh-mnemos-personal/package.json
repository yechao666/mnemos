{
  "name": "dsh-mnemos-personal",
  "version": "0.1.0",
  "description": "Mnemos v6（中立记忆服务）接入 dsh：以工作区为分区（Partition）、记忆按人（Person）组织，提供 mnemos_workspace / mnemos_add / mnemos_search / mnemos_get / mnemos_brief / mnemos_context / mnemos_person / mnemos_status 8 个 Agent 工具。只需主机半边，通过 `dsh plugin --profile <name> add link:<path>` 热插拔，不改 dsh 源码。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "watch": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.7.2"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.4.0"
}
